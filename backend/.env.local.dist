# Exemple de configuration LOCALE (développement).
# Copier en `.env.local` et remplir. Ce fichier .dist est versionné, PAS .env.local.
# En PRODUCTION, ces variables sont fournies par Docker (voir deploy/.env.example).

APP_ENV=dev
APP_SECRET=change_me_32_hex

# Base de données (MariaDB locale)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/lotr_deckbuilder?serverVersion=11.6.2-MariaDB&charset=utf8mb4"

# JWT — passphrase des clés config/jwt/*.pem (générées via lexik:jwt:generate-keypair)
JWT_PASSPHRASE=change_me_hex

# Mercure (hub temps réel local sur :3000)
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_JWT_SECRET=change_me_min_32_chars
