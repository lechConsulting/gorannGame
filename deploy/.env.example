# Copier en `deploy/.env` sur le serveur et remplir les valeurs.
# Ce fichier .example est versionné ; deploy/.env ne l'est PAS (voir .gitignore).

# Domaine public de l'application
APP_DOMAIN=gorann.games.lechat-consulting.fr

# Secret Symfony — générer : openssl rand -hex 16
APP_SECRET=REMPLACER_32_hex

# Base MariaDB dédiée (dans Docker)
DB_NAME=gorann
DB_USER=gorann
DB_PASSWORD=REMPLACER_mot_de_passe_fort
DB_ROOT_PASSWORD=REMPLACER_mot_de_passe_root_fort

# JWT — passphrase des clés (générées au 1er démarrage) — openssl rand -hex 32
JWT_PASSPHRASE=REMPLACER_hex

# Mercure — secret de signature du hub — openssl rand -hex 32 (min 32 caractères)
MERCURE_JWT_SECRET=REMPLACER_min_32_caracteres
